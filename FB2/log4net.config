<log4net>
  <appender name="ExceptionRollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="D:\Kuozui\FB\FB2\Logs\"/>　<!--存放log檔案的路徑-->
    <staticLogFileName value="false"/>
    <appendToFile value="true"/>
    <rollingStyle value="Date"/>
    <datePattern value="yyyyMMdd_Trace.lo\g"/>　<!--log檔案的命名-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5p %date{yyyy/MM/dd HH:mm:ss} %property{FunID} %-20c{1} %-10property{WorkID} %-20M %m%n" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <param name="LevelMin" value="ERROR" />
      <param name="LevelMax" value="ERROR" />
    </filter>
  </appender>
  <appender name="RequestRollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="D:\Kuozui\FB\FB2\Logs\"/>　<!--存放log檔案的路徑-->
    <staticLogFileName value="false"/>
    <appendToFile value="true"/>
    <rollingStyle value="Date"/>
    <datePattern value="yyyyMMdd_Reque\s\t.lo\g"/>　<!--log檔案的命名-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5p %date{yyyy/MM/dd HH:mm:ss} %property{FunID} %-20c{1} %-10property{WorkID} %-20M %m%n" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <param name="LevelMin" value="INFO" />
      <param name="LevelMax" value="INFO" />
    </filter>
  </appender>
  <appender name="WarnRollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="D:\Kuozui\FB\FB2\Logs\"/>　<!--存放log檔案的路徑-->
    <staticLogFileName value="false"/>
    <appendToFile value="true"/>
    <rollingStyle value="Date"/>
    <datePattern value="yyyyMMdd_Warn.lo\g"/>　<!--log檔案的命名-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5p %date{yyyy/MM/dd HH:mm:ss} %property{FunID} %-20c{1} %-10property{WorkID} %-20M %m%n" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <param name="LevelMin" value="WARN" />
      <param name="LevelMax" value="WARN" />
    </filter>
  </appender>
  <appender name="TraceRollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="D:\Kuozui\FB\FB2\Logs\"/>　<!--存放log檔案的路徑-->
    <staticLogFileName value="false"/>
    <appendToFile value="true"/>
    <rollingStyle value="Date"/>
    <datePattern value="yyyyMMdd_TraceSQL.lo\g"/>　<!--log檔案的命名-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5INFO %date{yyyy/MM/dd HH:mm:ss} %property{FunID} %-20c{1} %-10property{WorkID} %-20M %m%n" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <param name="LevelMin" value="DEBUG" />
      <param name="LevelMax" value="DEBUG" />
    </filter>
  </appender>
  <root>
    <level value="ALL"/>
    <appender-ref ref="ExceptionRollingFileAppender"/>
    <appender-ref ref="RequestRollingFileAppender"/>
    <appender-ref ref="WarnRollingFileAppender"/>
  </root>
  <logger name="TraceSQL">
    <level value="DEBUG"/>
    <appender-ref ref="TraceRollingFileAppender"/>
  </logger>
</log4net>