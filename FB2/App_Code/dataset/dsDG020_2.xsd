                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT         TAD.EMP_ID, TM.EMP_NAME, TM.DEPT_NO, 
                          TD.DIV_DEPT_FULL_NAME AS DEPT_NAME, TD.DEPT_NAME_40, 
                          TD.DEPT_NAME_30, TE.WORK_SHIFT_CD, TE.PLANT_CD, 
                          TCD.SUB_DESC AS CAR_BRAND, TM.PARKING_TOOL, TM.CAR_PARK_NO, 
                          TPM.PARKING_NAME, TM.CAR_NO, TAD.UPDATED_DT, TAD.TRANSPORT_CD, 
                          TM.PARKING_TOOL AS Expr1, '' AS 'Lapse'
FROM             TB_D_M_PARKING_EMP_MAIN AS TM LEFT OUTER JOIN
                          TB_D_M_TRANS_ALLOWANCE_D AS TAD ON 
                          TAD.EMP_ID = TM.EMP_ID LEFT OUTER JOIN
                          VW_H_EMP_DATA AS TE ON TM.EMP_ID = TE.EMP_ID LEFT OUTER JOIN
                          TB_H_R_DEPT_DATA AS TD ON TM.DEPT_NO = TD.DEPT_NO LEFT OUTER JOIN
                          TB_D_M_PARKING_MAIN AS TPM ON 
                          TPM.CAR_PARK_NO = TM.CAR_PARK_NO LEFT OUTER JOIN
                          TB_9_M_COMM_D AS TCD ON TM.CAR_BRAND = TCD.SUB_CD AND 
                          TCD.SYS_CD = 'DG' AND TCD.MAIN_CD = 'CAR_BRAND'</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
