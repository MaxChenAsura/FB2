                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT         TM.EMP_ID, TM.EMP_NAME, TM.DEPT_NO, TD.DEPT_NAME, 
                          TD.DEPT_NAME_30, TD.DEPT_NAME_40, TE.WORK_SHIFT_CD, TE.PLANT_CD, 
                          TM.CAR_BRAND, TM.PARKING_TOOL, TPM.PARKING_NAME, TM.CAR_NO, 
                          TM.UPDATED_BY, TM.UPDATED_DT
FROM             TB_D_M_PARKING_EMP_MAIN AS TM LEFT OUTER JOIN
                          VW_H_DEPT_DATA AS TD ON TM.DEPT_NO = TD.DEPT_NO LEFT OUTER JOIN
                          VW_H_EMP_DATA AS TE ON TM.EMP_ID = TE.EMP_ID LEFT OUTER JOIN
                          TB_H_M_PJOB AS TP ON TP.PJOB_CD = TE.PJOB_CD LEFT OUTER JOIN
                          TB_9_M_COMM_D AS TCD ON TM.CAR_BRAND = TCD.SUB_CD AND 
                          TCD.SYS_CD = 'DG' AND TCD.MAIN_CD = 'CAR_BRAND' LEFT OUTER JOIN
                          TB_D_M_PARKING_MAIN AS TPM ON TPM.CAR_PARK_NO = TM.CAR_PARK_NO</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
