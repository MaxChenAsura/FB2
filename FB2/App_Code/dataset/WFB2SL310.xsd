                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>Select
D.LICENSE_ID,
D.TAX_FORMAT,
D.TAX_SEQ,
D.AMOUNT,
D.TAX,
D.INCOME,
D.RETIRE_AMT,
D.EMP_ID,
D.EMP_NAME,
dbo.FN_H_sConvert(D.REGISTER_ADDR,0)AS REGISTER_ADDR,
D.PAY_YR,
D.PAY_YM_START,
D.PAY_YM_END,
D.DUE_183,
isnull(D.COUNTRY_CD,'') COUNTRY_CD,
isnull(D.TAX_DEAL_CD,'') TAX_DEAL_CD,
M.COMPANY_ID,
M.TAX_ORG_ID,
M.COMPANY_NAME,
M.COMPANY_ADDR,
M.CHAIRMAN_NAME
From TB_S_R_IMX_DTL D
Join TB_S_R_IMX_COMPANY M On LEFT(D.DATA_YM,4) = LEFT(M.DATA_YM,4) And D.COMPANY_CD = M.COMPANY_CD
Where LEFT(D.DATA_YM,4) = @DATA_YM
And D.LICENSE_ID = @LICENSE_ID
</CommandText>
