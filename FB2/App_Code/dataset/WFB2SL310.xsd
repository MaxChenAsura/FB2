                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>select A.WK_COMPANY_CD, A.WK_IDENTITY_KIND, A.WK_EMP_ID, A.WK_LICENSE_ID
, A.WK_INS_NAME, A.WK_INS_TYPE, A.WK_INS_TOTAL,M.COMPANY_NAME, M.COMPANY_ADDR
, M.CHAIRMAN_NAME 
From ( 
		Select M.COMPANY_CD As WK_COMPANY_CD,'本人' As WK_IDENTITY_KIND
		,V.EMP_ID As WK_EMP_ID, V.LICENSE_ID As WK_LICENSE_ID,V.EMP_NAME As WK_INS_NAME,D.SUB_DESC As WK_INS_TYPE
		, Sum(M.INS_TOTAL) As WK_INS_TOTAL 
		From TB_I_R_FEES_MONTH M Join VW_H_EMP_DATA V On M.EMP_ID = V.EMP_ID
		left join TB_9_M_COMM_D D on D.SYS_CD='IA' AND D.MAIN_CD ='INS_TYPE' and D.SUB_CD = M.INS_TYPE  
		Where  M.IDENTITY_KIND = '1' And M.IS_YN = 'Y' And M.SALARY_DT Between @SALARY_DT1 And @SALARY_DT2 
		And V.LICENSE_ID = @LICENSE_ID AND M.INS_TOTAL &gt;0
		Group By M.COMPANY_CD, M.IDENTITY_KIND, V.EMP_ID, V.LICENSE_ID, V.EMP_NAME, M.INS_TYPE,D.SUB_DESC 
	Union all 
		Select M.COMPANY_CD As WK_COMPANY_CD,T.SUB_DESC As WK_IDENTITY_KIND
		,M.EMP_ID As WK_EMP_ID, F.FAMILY_LICENSE_ID As WK_LICENSE_ID,F.FAMILY_NAME As WK_INS_NAME
		,D.SUB_DESC As WK_INS_TYPE, Sum(M.INS_TOTAL) As WK_INS_TOTAL 
		From TB_I_R_FEES_MONTH M 
		left Join TB_H_M_EMP_FAMILY F On M.EMP_ID = F.EMP_ID and M.LICENSE_ID=F.FAMILY_LICENSE_ID  
		left Join VW_H_EMP_DATA V On M.EMP_ID = V.EMP_ID
		left join TB_9_M_COMM_D D on D.SYS_CD='IA' AND D.MAIN_CD ='INS_TYPE' and D.SUB_CD = M.INS_TYPE 
		left join TB_9_M_COMM_D T on T.SYS_CD='HB' AND T.MAIN_CD ='FAMILY_RELATION' and T.SUB_CD = F.FAMILY_RELATION 
		 Where M.IDENTITY_KIND = '2' And M.IS_YN = 'Y' And M.SALARY_DT Between @SALARY_DT1 And @SALARY_DT2 
		 AND V.LICENSE_ID = @LICENSE_ID AND M.INS_TOTAL &gt;0
		 Group By M.COMPANY_CD, T.SUB_DESC, M.EMP_ID, F.FAMILY_LICENSE_ID
		 , F.FAMILY_NAME, M.INS_TYPE,D.SUB_DESC
 ) A 
 Join TB_S_R_IMX_COMPANY M On A.WK_COMPANY_CD = M.COMPANY_CD And M.DATA_YM = @DATA_YM </CommandText>
