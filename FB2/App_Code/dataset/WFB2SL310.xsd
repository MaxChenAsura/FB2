                      <Parameter AllowDbNull="false" AutogeneratedName="DATA_YM" ColumnName="DATA_YM" DataSourceName="FB2DB.dbo.TB_S_R_IMX_COMPANY" DataTypeServer="varchar(4)" DbType="AnsiString" Direction="Input" ParameterName="@DATA_YM" Precision="0" ProviderType="VarChar" Scale="0" Size="4" SourceColumn="DATA_YM" SourceColumnNullMapping="false" SourceVersion="Current" />
