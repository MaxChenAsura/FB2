        <Tables>
          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="SD130ExcelTableAdapter" GeneratorDataComponentClassName="SD130ExcelTableAdapter" Name="SD130Excel" UserDataComponentName="SD130ExcelTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="dbconnection (Web.config)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT          a.EMP_ID, c.EMP_NAME, c.DEPT_NO, c.PLANT_CD, c.PJOB_CD, c.JOIN_DT, c.EMP_CD, c.WS_CD, c.WORK_YEARS, 
                            e.SUB_DESC AS FESTIVAL_TYPE_NAME, SUM(CASE WHEN SALARY_ID &lt;&gt; '4001' THEN (a.AMOUNT * a.IS_PLUS) 
                            END) AS 節金金額, SUM(CASE WHEN SALARY_ID = '4001' THEN a.AMOUNT END) AS 稅額, 
                            SUM(CASE WHEN SALARY_ID &lt;&gt; '4001' THEN (a.AMOUNT * a.IS_PLUS) END) 
                            - SUM(CASE WHEN SALARY_ID = '4001' THEN a.AMOUNT END) AS '實領金額'
FROM              TB_S_M_SALARY_PAY AS a LEFT OUTER JOIN
                                (SELECT DISTINCT FESTIVAL_TYPE, FESTIVAL_DT, FESTIVAL_PAY_DT, SALARY_DT
                                  FROM               TB_S_M_FESTIVAL_H AS zb) AS b ON a.SALARY_DT = b.SALARY_DT LEFT OUTER JOIN
                            TB_S_R_FESTIVAL_D AS c ON b.FESTIVAL_TYPE = c.FESTIVAL_TYPE AND b.FESTIVAL_DT = c.FESTIVAL_DT AND 
                            a.SALARY_DT = b.FESTIVAL_PAY_DT AND a.EMP_ID = c.EMP_ID LEFT OUTER JOIN
                            TB_9_M_COMM_D AS e ON e.SYS_CD = 'SG' AND e.MAIN_CD = 'FESTIVAL_TYPE' AND 
                            e.SUB_CD = c.FESTIVAL_TYPE
WHERE          (a.COMPANY_CD = 'T')
GROUP BY   a.EMP_ID, c.EMP_NAME, c.DEPT_NO, c.PLANT_CD, c.PJOB_CD, c.JOIN_DT, c.EMP_CD, c.WS_CD, c.WORK_YEARS, 
                            e.SUB_DESC</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
