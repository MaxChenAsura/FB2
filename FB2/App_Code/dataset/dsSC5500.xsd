            <MainSource>
              <DbSource ConnectionRef="dbconnection (Web.config)" DbObjectName="SELECT A.INCOME_CD,A.SALARY_DT,COUNT(A.EMP_ID) CNT,SUM(A.TAX) TAX,SUM(B.AMOUNT) AMOUNT FROM (SELECT X.EMP_ID,X.SALARY_DT,(CASE X.TAX WHEN 0 THEN 'N' ELSE X.INCOME_CD END) AS INCOME_CD,X.TAX FROM ( SELECT EMP_ID,SALARY_DT,INCOME_CD,SUM(AMOUNT) TAX FROM TB_S_M_SALARY_PAY WHERE SALARY_TYPE = 'A' AND SALARY_ID = '4001' GROUP BY EMP_ID,SALARY_DT, INCOME_CD ) AS X ) AS A JOIN ( SELECT EMP_ID,SALARY_DT, SUM(AMOUNT * IS_PLUS) AMOUNT FROM TB_S_M_SALARY_PAY WHERE SALARY_TYPE = 'A' AND SALARY_ID &lt;&gt; '4001' GROUP BY EMP_ID,SALARY_DT) AS B ON A.EMP_ID = B.EMP_ID GROUP BY A.INCOME_CD,A.SALARY_DT" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="sc550" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="sc550" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="sc550" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>select * from(
Select A.INCOME_CD,A.SALARY_DT,Count(A.EMP_ID) CNT,Sum(A.TAX) TAX,Sum(B.AMOUNT) AMOUNT	
From (Select X.EMP_ID,X.SALARY_DT,(Case X.TAX When 0 Then 'N' Else X.INCOME_CD End) As INCOME_CD,X.TAX From (
	Select EMP_ID,SALARY_DT,INCOME_CD,Sum(AMOUNT) TAX 
	From TB_S_M_SALARY_PAY
Where SALARY_TYPE = 'A'
And SALARY_ID = '4001'
Group By EMP_ID,SALARY_DT, INCOME_CD
	) As X ) As A	
Join (	
	Select 	EMP_ID,SALARY_DT,	Sum(AMOUNT * IS_PLUS) AMOUNT
		From TB_S_M_SALARY_PAY
	Where SALARY_TYPE = 'A'
	And SALARY_ID &lt;&gt; '4001'
	Group By EMP_ID,SALARY_DT) As B	
On A.EMP_ID = B.EMP_ID	
Group By A.INCOME_CD,A.SALARY_DT	)td
where 1=1
</CommandText>
