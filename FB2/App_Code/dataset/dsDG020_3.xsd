              <DbSource ConnectionRef="dbconnection (Web.config)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT         TM.EMP_ID, TM.EMP_NAME, TE.WS_CD, TM.DEPT_NO, 
                          TD.DIV_DEPT_FULL_NAME AS DEPT_NAME, TD.DEPT_NAME_40, 
                          TE.WORK_SHIFT_CD, TE.PLANT_CD, TP.PJOB_DESC, TM.CAR_PARK_NO, 
                          PM.PARKING_NAME, TM.PARKING_TOOL, TCD.SUB_DESC, TM.CAR_NO, 
                          TM.UPDATED_DT, TE.LEVEL_CD, TD.DEPT_NAME_20
FROM             TB_D_M_PARKING_EMP_MAIN AS TM LEFT OUTER JOIN
                          TB_H_R_DEPT_DATA AS TD ON TM.DEPT_NO = TD.DEPT_NO LEFT OUTER JOIN
                          VW_H_EMP_DATA AS TE ON TM.EMP_ID = TE.EMP_ID LEFT OUTER JOIN
                          TB_H_M_PJOB AS TP ON TP.PJOB_CD = TE.PJOB_CD LEFT OUTER JOIN
                          TB_9_M_COMM_D AS TCD ON TM.CAR_BRAND = TCD.SUB_CD AND 
                          TCD.SYS_CD = 'DG' AND TCD.MAIN_CD = 'CAR_BRAND' LEFT OUTER JOIN
                          TB_D_M_PARKING_MAIN AS PM ON 
                          TM.CAR_PARK_NO = PM.CAR_PARK_NO
ORDER BY  TM.EMP_ID</CommandText>
