                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT          V.DEPT_NO, V.DEPT_NAME_20, V.DEPT_NAME_40, P.EMP_ID, V.EMP_NAME, SUM(P.AMOUNT) AS AMOUNT,
                                (SELECT          SUM(S.AMOUNT * S.IS_PLUS) AS TAX
                                  FROM               TB_S_M_SALARY_PAY AS S INNER JOIN
                                                              TB_S_M_SALARY_ITEM AS I ON S.SALARY_ID = I.SALARY_ID AND S.EMP_ID = P.EMP_ID AND 
                                                              S.PAY_KIND = '9999' AND I.SALARY_CD = '4') AS TAX
FROM              TB_S_M_STAFF_ARREARS_D AS P INNER JOIN
                            VW_H_EMP_DATA AS V ON P.EMP_ID = V.EMP_ID
GROUP BY   V.DEPT_NO, V.DEPT_NAME_20, V.DEPT_NAME_40, P.EMP_ID, V.EMP_NAME
ORDER BY   V.DEPT_NO, P.EMP_ID</CommandText>
