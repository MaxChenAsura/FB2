    protected void Page_Load(object sender, EventArgs e)
    {
        ScriptManager.RegisterClientScriptBlock(this.Page, this.GetType(), "init", "iniForm();", true);
        ViewState["Queryble"] = false;          //設定執行增/修時,改變查詢條件不會重查
        gv_result.PagerSettings.Visible = true; //設定執行增/修時,隱藏GridView的換頁列
        ViewState["Queryble2"] = false;          //設定執行增/修時,改變查詢條件不會重查
        gv_result2.PagerSettings.Visible = true; //設定執行增/修時,隱藏GridView的換頁列
        if (!IsPostBack)
        {
            //第一次進入時，頁碼為0
            ViewState["NewPageIndex"] = 0; //第一次進入時，頁碼為0
            ViewState["NewPageIndex2"] = 0;
        }
        //控制Gridview分頁，若有分頁直接copy這段
        if (HID_PageRow.Value != "")
        {
            //ViewState["SetPerRow"] = true;
            getGridView(ViewState["SortExpression"].ToString(), 0, Convert.ToInt32(HID_PageRow.Value));
        }
        if (HID_PageRow2.Value != "")
        {
            //ViewState["SetPerRow"] = true;
            getGridView2(ViewState["SortExpression2"].ToString(), 0, Convert.ToInt32(HID_PageRow2.Value));
        }
    }
    //查詢功能
    protected void WFB2SH3100Search_Click(object sender, EventArgs e)
    {
        try
        {
            ViewState["Queryble"] = true;
            ViewState["SetPerRow"] = true; //GridView有分頁需加這行，設定每頁幾筆變數
            ViewState["SortExpression"] = null; //排序欄位
            ViewState["SortDirection"] = null; //排序順序，null = 回復成正常排序
            ViewState["Queryble2"] = true;
            ViewState["SetPerRow2"] = true; //GridView有分頁需加這行，設定每頁幾筆變數
            ViewState["SortExpression2"] = null; //排序欄位
            ViewState["SortDirection2"] = null; //排序順序，null = 回復成正常排序
            //HID_PageRow.Value = "";

            //GridView有分頁此段必加 begin
            if (ViewState["PerPageRow"] != null && ViewState["PerPageRow"].ToString() != "")
                getGridView("PJOB_CD", 0, Convert.ToInt32(ViewState["PerPageRow"]));
            else
                getGridView("PJOB_CD", 0, 10);
            //end
           //GridView2有分頁此段必加 begin
            if (ViewState["PerPageRow2"] != null && ViewState["PerPageRow2"].ToString() != "")
                getGridView2("PJOB_CD", 0, Convert.ToInt32(ViewState["PerPageRow2"]));
            else
                getGridView2("PJOB_CD", 0, 10);
            //不顯示編輯列及新增列
            gv_result.EditIndex = -1;
            gv_result.ShowFooter = false; 

            if (gv_result.Rows.Count > 0)
            {
                WFB2SH3100Add.Visible = true;
                WFB2SH3100Edit.Visible = true;
                WFB2SH3100Delete.Visible = true;
            }
            else
            {
                WFB2SH3100Edit.Visible = false;
                WFB2SH3100Delete.Visible = false;
                showMessage("QryNotFoundMessage");
            }

            gv_result2.EditIndex = -1;
            gv_result2.ShowFooter = false;
            if (gv_result.Rows.Count > 0)
            {
                WFB2SH3102Add.Visible = true;
                WFB2SH3102Edit.Visible = true;
                WFB2SH3102Delete.Visible = true;
            }
            else
            {
                WFB2SH3102Edit.Visible = false;
                WFB2SH3102Delete.Visible = false;
                showMessage("QryNotFoundMessage");
            }

        }
        catch (Exception ex)
        {
            logger.Error(ex.Message);
            ScriptManager.RegisterClientScriptBlock(this.Page, this.GetType(), "error", "alert('" + ex.Message + "');", true);
        }
    }
