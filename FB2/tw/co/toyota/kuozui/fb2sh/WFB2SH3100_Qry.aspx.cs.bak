    //職務代號(考績格差設定)
    protected void txt_NEW_PJOB_CD_TextChanged(object sender, EventArgs e)
    {
        try
        {
            //職務代號
            TextBox txt_NEW_PJOB_CD = new TextBox();
            //職務代名稱
            Label lbl_NEW_PJOB_NAME = new Label();

            if (gv_result.Rows.Count == 0)
            {
                txt_NEW_PJOB_CD = (TextBox)gv_result.Controls[0].Controls[0].FindControl("txt_NEW_PJOB_CD");
                lbl_NEW_PJOB_NAME = (Label)gv_result.Controls[0].Controls[0].FindControl("lbl_NEW_PJOB_NAME");
            }
            else
            {
                txt_NEW_PJOB_CD = (TextBox)gv_result.Controls[0].Controls[0].FindControl("txt_NEW_PJOB_CD");
                lbl_NEW_PJOB_NAME = (Label)gv_result.Controls[0].Controls[0].FindControl("lbl_NEW_PJOB_NAME");
            }
            if (txt_NEW_PJOB_CD != null)
            {
                DataTable dt = service.getPJOB_NAME(txt_NEW_PJOB_CD.Text);
                if (dt.Rows.Count > 0)
                {
                    lbl_NEW_PJOB_NAME.Text = dt.Rows[0]["PJOB_DESC"].ToString();
                }
                else
                {
                    lbl_NEW_PJOB_NAME.Text = "";
                }
            }

        }
        catch (Exception ex)
        {
            logger.Error(ex.Message);
            ScriptManager.RegisterClientScriptBlock(this.Page, this.GetType(), "error", "alert('" + ex.Message + "');", true);
        }
    }

